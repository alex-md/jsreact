{
  "name": "jsreact",
  "version": "1.0.0",
  "description": "A collection of JavaScript utilities and tools for web development",
  "scripts": {
    "clean": "rm -rf dist",
    "create-dirs": "mkdir -p dist/styles dist/images dist/scripts",
    "build:js": "swc src -d dist",
    "build:css": "postcss src/styles/*.css -d dist/styles",
    "build:html": "cp src/*.html dist/",
    "build:assets": "cp -r src/images src/robots.txt src/sitemap.xml src/_headers src/_redirects dist/",
    "build": "npm run clean && npm run create-dirs && npm run build:js && npm run build:css && npm run build:html && npm run build:assets",
    "dev:js": "swc src -d dist -w",
    "dev:css": "postcss src/styles/*.css -d dist/styles --watch",
    "dev:serve": "live-server dist --port=3000",
    "dev": "npm run clean && npm run create-dirs && (npm run dev:js & npm run dev:css & npm run dev:serve)",
    "pages:build": "npm run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "terser": "^5.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.9.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "html-webpack-plugin": "^5.6.0",
    "live-server": "^1.2.2",
    "mini-css-extract-plugin": "^2.7.7",
    "postcss": "^8.4.33",
    "postcss-cli": "^11.0.0",
    "postcss-loader": "^7.3.4",
    "postcss-preset-env": "^9.3.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
