# Cache assets with a hash in the filename
/*.*.js
  Cache-Control: public, max-age=31536000, immutable
/*.*.css
  Cache-Control: public, max-age=31536000, immutable
/*.*.png
  Cache-Control: public, max-age=31536000, immutable
/*.*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.*.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML files and data files - no caching
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
